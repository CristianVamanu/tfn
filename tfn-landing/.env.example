# SQLite (default, fine for local dev):
DATABASE_URL=sqlite:///./data/tfn.db
# MySQL (production - see scripts/migrate_sqlite_to_mysql.py to move existing data over):
# DATABASE_URL=mysql+pymysql://tfn_app:PASSWORD@127.0.0.1:3306/tfn?charset=utf8mb4
DASHBOARD_PORT=8004

# Session cookie signing key - REQUIRED in production. Without it, a random
# key is generated on every process start and every logged-in user is
# signed out on each deploy/restart. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Whichever email signs up with this address is made an admin automatically
# (gets access to /admin). Leave blank to disable auto-admin.
ADMIN_EMAIL=

# Cloudflare R2 (S3-compatible object storage) - for avatars / marketplace files.
# Create a bucket + API token (Object Read & Write) at dash.cloudflare.com > R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
