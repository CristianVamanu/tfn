# Exchange used for PUBLIC market data only (no API key needed - this is a
# paper trading platform, no real orders are ever sent to the exchange).
EXCHANGE_ID=binance

# Symbols the support/resistance scanner watches, comma-separated (ccxt format).
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT

# The three legs of the triangular arbitrage loop, in order
# (e.g. USDT -> BTC -> ETH -> USDT).
ARBITRAGE_TRIANGLE=BTC/USDT,ETH/BTC,ETH/USDT

# Starting virtual balance for the paper trading account.
PAPER_STARTING_BALANCE_USDT=10000

# Assumed round-trip trading fee per leg (percent). Binance spot default is 0.1.
TRADING_FEE_PCT=0.1

# Minimum net profit (percent, after fees) required to flag a triangular
# arbitrage signal.
MIN_ARB_PROFIT_PCT=0.15

# How much of available USDT cash to commit to a single support/resistance
# trade signal (percent).
POSITION_SIZE_PCT=10

# How often the strategy loop scans for signals, in seconds.
SCAN_INTERVAL_SECONDS=60

# Your own Anthropic API key (console.anthropic.com) - required for the AI
# review gate that approves/rejects candidate signals before execution.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# SQLite database file (absolute path recommended in production).
DATABASE_URL=sqlite:///./data/trading.db

# Port the dashboard web server listens on (nginx reverse-proxies to this).
DASHBOARD_PORT=8001
