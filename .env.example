# CreatorPulse .env bootstrap placeholders
# Admin panel (DB) remains the primary configuration store; only set these when you need an explicit override.

# Core
APP_DEBUG=false
BASE_URL=
APP_KEY=
STORAGE_ENCRYPTION_KEY=
# (Installer populates these automatically. If you create .env manually, generate fresh base64-encoded secrets before production.)

# Database
DB_HOST=127.0.0.1
DB_DATABASE=creatorpulse
DB_USERNAME=
DB_PASSWORD=

# Scheduler / automation
SUBSCRIPTIONS_CRON_SECRET=
CRON_SUBSCRIPTIONS_TOKEN=

# Payments (optional overrides; Admin Panel values win when present)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_WEBHOOK_SECRET=
NOWPAYMENTS_CURRENCY=

COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
COINBASE_CURRENCY=

# Push / Notifications (optional overrides)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_SAFARI_WEB_ID=
ONESIGNAL_ENABLED=false
ONESIGNAL_AUTO_PROMPT=true

# Storage (advanced overrides)
STORAGE_DRIVER=
STORAGE_CONFIG_JSON=
STORAGE_PUBLIC_BASE_URL=
STORAGE_DEFAULT_VISIBILITY=
STORAGE_DEFER_NETWORK=false

# Security headers
CSP_CONNECT_SRC=
CSP_ALLOW_INLINE_STYLES=false
EMBED_FRAME_ANCESTORS=*

# Sessions & media helpers
SESSION_COOKIE_LIFETIME=
DZ_ADD_IMAGE_DIMENSIONS=false
